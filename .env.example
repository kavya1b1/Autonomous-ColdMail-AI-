# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=800

# SMTP (leave blank for demo mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDER_NAME=ColdMail AI
SENDER_EMAIL=

# Safety: real email delivery is OFF by default
DEMO_MODE=true
ENABLE_REAL_EMAIL_SEND=false

# App
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Limits
MAX_EMAILS_PER_BATCH=10
DELAY_BETWEEN_EMAILS=30
MAX_DAILY_EMAILS=20

# Optional infrastructure
# DATABASE_URL (below) is the original Postgres config; it is currently
# unused (never wired to a running Postgres instance). User accounts,
# profiles, and campaign history are persisted with AUTH_DATABASE_URL
# instead — defaults to a local SQLite file (./coldmail.db) so the app
# runs with zero external services. Point it at Postgres in production.
# AUTH_DATABASE_URL=postgresql://user:pass@localhost:5432/coldmail
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coldmail
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=coldmail_memory
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Extraction budget (keeps pasted recruiter/JD text below Groq TPM limits)
GROQ_EXTRACTION_MAX_INPUT_CHARS=12000
GROQ_EXTRACTION_MAX_TOKENS=1200

# Research guardrails
RESEARCH_HTTP_TIMEOUT=8
RESEARCH_MAX_CONCURRENCY=4

# LangGraph checkpoint deserialization hardening
LANGGRAPH_STRICT_MSGPACK=true
